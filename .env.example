# Supabase Configuration
# Kopieer dit bestand naar .env.local en vul je eigen credentials in

NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Urban Culture agenda feed (read-only API for UC sync)
# Zelfde waarde als CORRIDOR_AGENDA_API_KEY op Urban Culture Vercel
# CORRIDOR_AGENDA_API_KEY=

# Read-only key voor GET /api/v1/media en GET /api/v1/zones.
# Valt terug op CORRIDOR_AGENDA_API_KEY als deze leeg is.
# CORRIDOR_MEDIA_API_KEY=

# Schrijf-key voor PATCH /api/v1/media/:id. Wijzigt alleen het credit-veld.
# Moet gezet zijn en mag niet dezelfde waarde zijn als de read-only keys.
# CORRIDOR_MEDIA_WRITE_API_KEY=

# Absolute URLs voor geschiedenis-items en zone-covers (bv. https://corridor.gent)
# CORRIDOR_SITE_URL=
