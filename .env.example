# Supabase Configuration
# Kopieer dit bestand naar .env.local en vul je eigen credentials in.
# Vercel-checklist voor Florian: SUPABASE_SECURITY.md

# Publiek (browser). De anon key is bewust publiek; RLS beperkt de toegang.
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optioneel. Publieke site-URL voor auth-redirects (geen geheim).
# NEXT_PUBLIC_SITE_URL=https://corridor.gent

# Server-only. Supabase service role (bypassed RLS). Verplicht voor de admin client.
# Zet deze op Vercel voor Production, Preview én Development.
# Nooit een NEXT_PUBLIC_-prefix. Nooit in client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# VERWIJDEREN op Vercel (alle environments) als die nog bestaat.
# Die naam lekt de service role naar de browser:
# NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY

# Urban Culture agenda feed (read-only API for UC sync)
# Zelfde waarde als CORRIDOR_AGENDA_API_KEY op Urban Culture Vercel
# Server-only. Nooit NEXT_PUBLIC_.
# CORRIDOR_AGENDA_API_KEY=

# Optionele aparte read-only key voor GET /api/v1/media (val terug op agenda key)
# Server-only. Nooit NEXT_PUBLIC_.
# CORRIDOR_MEDIA_API_KEY=

# Absolute URLs voor geschiedenis-items in de media feed (bv. https://corridor.gent)
# Server-only. Geen geheim, maar ook geen NEXT_PUBLIC_-prefix nodig.
# CORRIDOR_SITE_URL=
